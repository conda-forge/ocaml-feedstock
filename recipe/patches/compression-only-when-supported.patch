Request marshal compression only when it is available.

utils/compression.ml passes [Compression] to caml_output_value
unconditionally, so a zstd runtime paired with a caml_zstd_initialize that
returns false crashes on every .cmi write. Gate the flag on
compression_supported.

--- a/utils/compression.ml
+++ b/utils/compression.ml
@@ -26,6 +26,7 @@
 external to_channel: out_channel -> 'a -> extern_flags list -> unit
                    = "caml_output_value"

-let output_value ch v = to_channel ch v [Compression]
+let output_value ch v =
+  to_channel ch v (if compression_supported then [Compression] else [])

 let input_value = Stdlib.input_value
