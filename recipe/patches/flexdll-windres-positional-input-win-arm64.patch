@@ -216,11 +216,21 @@
 version.res: version.rc flexdll.opam
 	$(RES_PREFIX) $(RC) /nologo $(RC_FLAGS) $<
 
+# zig's windres wrapper forwards "-i" verbatim to resinator, which follows
+# rc.exe semantics where -i means an include directory, not the input file,
+# so the resource script is dropped. GNU windres accepts positional input
+# too, so only the mingw64arm chain needs to switch syntax.
+ifeq ($(TOOLCHAIN),mingw64arm)
+WINDRES_INPUT = $<
+else
+WINDRES_INPUT = -i $<
+endif
+
 version_res.o: version.rc flexdll.opam
 	if command -v $(RC) >/dev/null 2>&1; then \
-	  $(RC) $(WINDRES_FLAGS) -i $< -o $@; \
+	  $(RC) $(WINDRES_FLAGS) $(WINDRES_INPUT) -o $@; \
 	elif command -v windres >/dev/null 2>&1; then \
-	  windres $(WINDRES_FLAGS) -i $< -o $@; \
+	  windres $(WINDRES_FLAGS) $(WINDRES_INPUT) -o $@; \
 	elif command -v x86_64-w64-mingw32-windres >/dev/null 2>&1; then \
-	  x86_64-w64-mingw32-windres $(WINDRES_FLAGS) -i $< -o $@; \
+	  x86_64-w64-mingw32-windres $(WINDRES_FLAGS) $(WINDRES_INPUT) -o $@; \
