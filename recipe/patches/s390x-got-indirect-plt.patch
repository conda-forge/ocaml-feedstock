+(* GOT-indirect call for runtime glue only -- avoids PLT lazy binding
+   trampoline which corrupts the heap when r15 points at the OCaml
+   fiber stack instead of a C stack frame (see #13693). *)
+let emit_call_got s =
+  if !Clflags.pic_code then begin
+   `	lgrl	%r1, {emit_symbol s}@GOT\n`;
+   `	basr	%r14, %r1\n`
+  end else
+   `	brasl	%r14, {emit_symbol s}\n`
+
