 static HANDLE units_mutex = INVALID_HANDLE_VALUE;
 
+/* TEMPORARY DIAGNOSTIC: CRT-free stderr markers (Win32 calls only), silent
+   unless the FLEXDLL_DIAG environment variable is set. */
+static int fd_dbg_on(void) {
+  static int on = -1;
+  if (on < 0) {
+    char b[2];
+    on = GetEnvironmentVariableA("FLEXDLL_DIAG", b, sizeof(b)) > 0;
+  }
+  return on;
+}
+
+static void fd_dbg(const char *s) {
+  DWORD n = 0, w;
+  HANDLE h = GetStdHandle(STD_ERROR_HANDLE);
+  if (!fd_dbg_on()) return;
+  while (s[n]) n++;
+  if (h != NULL && h != INVALID_HANDLE_VALUE) WriteFile(h, s, n, &w, NULL);
+}
+
+static void fd_dbg_hex(const char *tag, UINT_PTR v) {
+  char buf[19];
+  int i;
+  buf[0] = '0'; buf[1] = 'x';
+  for (i = 0; i < 16; i++)
+    buf[2 + i] = "0123456789abcdef"[(v >> (60 - 4 * i)) & 0xf];
+  buf[18] = 0;
+  fd_dbg(tag); fd_dbg(buf); fd_dbg("\r\n");
+}
