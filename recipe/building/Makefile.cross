	    ZIG_GLOBAL_CACHE_DIR="$(W7SS_ZIG_CACHE)" \
	    ZIG_LOCAL_CACHE_DIR="$(W7SS_ZIG_CACHE)" \
	    $(MAKE) --trace -j1 -C $(FLEXDLL_SOURCE_DIR) $(FLEXLINK_BUILD_ENV) CHAINS=mingw64 \
	      MIN64CC="$${_w37_native_cc_final}" \
	      $${_w7gg_oc:+CAMLOPT="$$_w7gg_oc" OCAMLOPT="$$_w7gg_oc" BEST_OCAMLOPT="$$_w7gg_oc"} \
	      NATDYNLINK=false LINKFLAGS="$$_w7hh10_linkflags" flexlink.exe support \
	      > "$$_w7hh4_selflink_log.retry" 2>&1 && _w7hh17_retry_rc=0 || _w7hh17_retry_rc=$$?; \
	    cat "$$_w7hh4_selflink_log.retry"; \
	    echo "[W7HH17-FAILOVER] stub-retry self-link rc=$$_w7hh17_retry_rc"; \
	    echo "[W7SS-DIAG] === (retry) isolated zig cache contents after the self-link: $(W7SS_ZIG_CACHE) ==="; \
	    ls -la "$(W7SS_ZIG_CACHE)" 2>/dev/null || echo "[W7SS-DIAG]   (dir absent or empty)"; \
	    find "$(W7SS_ZIG_CACHE)" -name 'crt2.obj' -print 2>/dev/null || true; \
	    echo "[W7HH20-DIAG] === retained startup assembly from the retry: $$_w7hh20_startup_s ==="; \
	    ls -la "$(FLEXDLL_SOURCE_DIR)"/flexlink.exe.startup.* 2>/dev/null || echo "[W7HH20-DIAG]   (no flexlink.exe.startup.* present)"; \
	    if [ -f "$$_w7hh20_startup_s" ]; then \
	      echo "[W7HH20-DIAG] SIZE=$$(wc -c < "$$_w7hh20_startup_s" 2>/dev/null || echo '?') bytes LINES=$$(wc -l < "$$_w7hh20_startup_s" 2>/dev/null || echo '?')"; \
	      echo "[W7HH24-SETTLED] THE STARTUP OBJECT IS FULLY EXONERATED -- do not probe it again. W7HH21: 18/18 generic fns .globl-exported. W7HH22: nm gave exactly 'T caml_curry2' and objdump gave pe-x86-64 / i386:x86-64. W7HH23: NATIVE_CC resolved to the SAME x86_64-windows-gnu zig command as _w37_native_cc_final, so the aspp wrapper and the direct CC cannot produce different objects; the assembled object had 121 generic-fn symbols, caml_curry2 as T at 0x2bc0, ordinary .text/.data/.bss/.rdata; and flexlink opens camlstartup FIRST of all objects. Emission, decoration, arch, wrapper and link order are ALL CLOSED."; \
	      echo "[W7HH24-SETTLED] AND THE 'needs caml_curry2 (not found)' LINES ARE NOT THE ERROR. flexdll reloc.ml:976-989: the Not_found branch only Printf.printf's, gated on !explain, sets no flag and raises nothing. Our own FLEXLINKFLAGS=-explain turns them on. W7HH20-W7HH23 were aimed at self-inflicted diagnostic noise. The real termination is the bare 'if !errors then exit 2' at reloc.ml:1053-1054, which bypasses the top-level printer and so emits NO banner."; \
	      echo "[W7HH24-DIAG] TOTAL .globl generic-fn definitions in the startup .s: $$(grep -cE '^[[:space:]]*\.globl[[:space:]]+_?caml_(apply|curry|tuplify)[0-9]+' "$$_w7hh20_startup_s" 2>/dev/null || echo 0)   (count retained ONLY so any future truncation stays self-evident)"; \
	    else \
	      echo "[W7HH20-DIAG] flexlink.exe.startup.s ABSENT despite -dstartup. The NAME is settled by asmlink.ml:281-285, so absence now means either keep_asm did not retain it (Asmgen.compile_unit path, not yet read) or ocamlopt failed before startup emission. Check the retry log tail above to tell which."; \
	    fi; \
	    echo "[W7HH20-DIAG] LINKFLAGS actually passed to the retry: $$_w7hh10_linkflags"; \
	    echo "[W7HH22-DIAG] === did flexlink actually READ the startup object? every retry-log line naming camlstartup ==="; \
	    if grep -qE '[Cc]amlstartup[A-Za-z0-9_]*\.(obj|o)' "$$_w7hh4_selflink_log.retry" 2>/dev/null; then \
	      grep -nE '[Cc]amlstartup[A-Za-z0-9_]*\.(obj|o)' "$$_w7hh4_selflink_log.retry" 2>/dev/null | head -25; \
	    else \
	      echo "[W7HH22-DIAG]   NONE -- the retry log never names camlstartup, so flexlink may never have read the startup object at all."; \
	    fi; \
	    echo "[W7HH24-DIAG] retry log TRUE size: $$(wc -l < "$$_w7hh4_selflink_log.retry" 2>/dev/null || echo '?') lines. The blanket cat at the failover above is CLIPPED by the CI log capture (prior rounds cited retry-log lines past 32880 while the whole CI log was ~10.4k lines), so every question about retry-log content must be answered by a grep HERE, never by reading the CI log afterwards."; \
	    echo "[W7HH24-DIAG] === THE ACTUAL ERROR. flexdll reloc.ml:1053-1054 is a bare 'if !errors then exit 2'. errors is set ONLY by error_imports (reloc.ml:950-957), which FIRST eprintf's '** Cannot resolve symbols for <name>:' and then the offending symbols on the FOLLOWING lines. main_pgm is true here, proven independently: reloc.ml:1050 emits the name 'static_symtable' only when main_pgm, and this build has an observed 'undefined symbol: static_symtable' plus the W7HH17 stub that exists to satisfy it. ==="; \
	    if grep -qE '\*\* Cannot resolve symbols for' "$$_w7hh4_selflink_log.retry" 2>/dev/null; then \
	      grep -nE -A30 '\*\* Cannot resolve symbols for' "$$_w7hh4_selflink_log.retry" 2>/dev/null | cut -c1-400 | sed 's/^/[W7HH24-DIAG]   resolve: /' | head -80; \
	    else \
	      echo "[W7HH24-DIAG]   ZERO MATCHES -- '** Cannot resolve symbols for' never printed, so errors was never set and the exit 2 does NOT come from reloc.ml:1054. That REFUTES the silent-exit theory outright and the exit must originate outside reloc.ml (Cmdline.ml parsing, or a signal)."; \
	    fi; \
	    echo "[W7HH24-DIAG] === every '+ ' command echo in the retry log. reloc.ml:1233 echoes the FINAL link command as '+ <cc ...>', but only AFTER the :1054 exit check. If the only '+' lines are ocamlopt's own flexlink and zig_aspp_wrapper invocations, the real linker was NEVER reached -- which is the signature of the :1054 exit. ==="; \
	    if grep -qE '^\+ ' "$$_w7hh4_selflink_log.retry" 2>/dev/null; then \
	      grep -nE '^\+ ' "$$_w7hh4_selflink_log.retry" 2>/dev/null | cut -c1-400 | sed 's/^/[W7HH24-DIAG]   cmd: /' | head -20; \
	    else \
	      echo "[W7HH24-DIAG]   no '+ ' command echoes at all in the retry log."; \
	    fi; \
	    echo "[W7HH24-DIAG] === flexlink's banner paths. EVERY other exit-2 route prints one of these first: reloc.ml:1591-1605 '** Fatal error'/'** Error', :234 and :239 'Error during linking', :1507 'Error while compiling', :358-361 'Cannot find file'. Absence of all of them isolates the silent :1054 exit. ==="; \
	    if grep -qE '\*\* (Fatal error|Error)' "$$_w7hh4_selflink_log.retry" 2>/dev/null; then \
	      grep -nE '\*\* (Fatal error|Error)' "$$_w7hh4_selflink_log.retry" 2>/dev/null | cut -c1-400 | sed 's/^/[W7HH24-DIAG]   banner: /' | head -15; \
	    else \
	      echo "[W7HH24-DIAG]   NONE -- no flexlink banner of any kind, consistent with the bare exit at reloc.ml:1054."; \
	    fi; \
	    if [ "$$_w7hh17_retry_rc" = "0" ]; then \
	      echo "[W7HH17-FAILOVER] SUCCESS: static_symtable stub unblocked flexlink.exe self-link; downstream steps proceed (NEXT blocker, if any, surfaces later). Stub export table is EMPTY -- acceptable for a bootstrap linker driver, revisit if flexlink dlopen misbehaves."; \
	      _w7hh_selflink_rc=0; \
	    else \
	      echo "[W7HH17-FAILOVER] stub retry STILL failed rc=$$_w7hh17_retry_rc -- static_symtable is NOT the sole blocker; inspect $$_w7hh4_selflink_log.retry above for the next undefined symbol"; \
	    fi; \
	  else \
	    echo "[W7HH17-FAILOVER] stub COMPILE FAILED:"; cat "$$_w7hh4_selflink_log.stub" 2>/dev/null || true; \
	  fi; \
	fi; \
	if [ -f "$(FLEXDLL_SOURCE_DIR)/.w7hh26_probe.log" ]; then \
	  echo "[W7HH27-PROBE-DUMP] === BEGIN probe output. Emitted HERE, late, because the identical echoes placed inline before the self-link were clipped from the CI log in build 1562996 while [W7HH17-DIAG] output at that same late position survived. ==="; \
	  cat "$(FLEXDLL_SOURCE_DIR)/.w7hh26_probe.log"; \
	  echo "[W7HH27-PROBE-DUMP] === END probe output ($$(wc -l < "$(FLEXDLL_SOURCE_DIR)/.w7hh26_probe.log" 2>/dev/null || echo '?') lines) ==="; \
	else \
	  echo "[W7HH27-PROBE-DUMP] probe log ABSENT at $(FLEXDLL_SOURCE_DIR)/.w7hh26_probe.log -- either the guard never opened or the writes failed; treat as NO RESULT, not as a negative finding"; \
	fi; \
	echo "[W7HH18-DIAG] === retained camlstartup (-dstartup) symbol dump after self-link ==="; \
	echo "[W7HH18-DIAG] ocamlopt writes the startup OBJECT to the OS TEMP dir as camlstartup*.obj. REFUTED, do NOT retry: it can never be captured -- asmlink.ml:348 temp-names it unconditionally on the exe-link path and :357 removes it via ~always inside Misc.try_finally, i.e. even when the link FAILS. W7HH19 proved TMPDIR pinning redirects the path yet the dir was still empty. The readable artifact is the .s (see W7HH20 above), not this. TMPDIR=$${TMPDIR:-<unset>} TMP=$${TMP:-<unset>} TEMP=$${TEMP:-<unset>}"; \
	_w7hh18_cands=""; \
	for _w7hh18_dir in "$(FLEXDLL_SOURCE_DIR)" "$${TMPDIR:-}" "$${TMP:-}" "$${TEMP:-}" /tmp; do \
	  [ -n "$$_w7hh18_dir" ] || continue; \
	  _w7hh18_udir="$$(cygpath -u "$$_w7hh18_dir" 2>/dev/null || echo "$$_w7hh18_dir")"; \
	  [ -d "$$_w7hh18_udir" ] || continue; \
	  _w7hh18_cands="$$_w7hh18_cands $$(find "$$_w7hh18_udir" -maxdepth 2 \( -name 'camlstartup*.s' -o -name 'camlstartup*.o' -o -name 'camlstartup*.obj' \) 2>/dev/null)"; \
	done; \
	for _w7hh18_log in "$$_w7hh4_selflink_log" "$$_w7hh4_selflink_log.retry"; do \
	  [ -f "$$_w7hh18_log" ] || continue; \
	  for _w7hh18_hit in $$(grep -oE '[A-Za-z]:[^ ]*[Cc]amlstartup[A-Za-z0-9_]*\.(obj|o|s)' "$$_w7hh18_log" 2>/dev/null | sort -u); do \
	    _w7hh18_cands="$$_w7hh18_cands $$(cygpath -u "$$_w7hh18_hit" 2>/dev/null || echo "$$_w7hh18_hit")"; \
	  done; \
	done; \
	echo "[W7HH18-DIAG] camlstartup candidates: $${_w7hh18_cands:-<NONE FOUND>}"; \
	for _w7hh16_su in $$(for _w7hh18_c in $$_w7hh18_cands; do echo "$$_w7hh18_c"; done | sort -u); do \
	  echo "[W7HH16-DIAG] camlstartup artifact: $$_w7hh16_su"; \
	  if [ ! -f "$$_w7hh16_su" ]; then echo "[W7HH18-DIAG]   MISSING on disk -- this path came from the self-link log scrape and ocamlopt has since deleted it. Absence here is NOT evidence that camlstartup lacks the generic fns; do NOT conclude anything from it."; continue; fi; \
	  case "$$_w7hh16_su" in \
	    *.s) grep -Ei 'caml_apply[0-9]|caml_curry[0-9]|caml_tuplify[0-9]' "$$_w7hh16_su" 2>/dev/null || echo "[W7HH16-DIAG]   (no generic-fn defs in .s)"; ;; \
	    *) if [ -n "$$_w7hh16_nm" ]; then "$$_w7hh16_nm" "$$_w7hh16_su" 2>/dev/null | grep -Ei 'caml_apply[0-9]|caml_curry[0-9]|caml_tuplify[0-9]' || echo "[W7HH16-DIAG]   (no generic-fn defs in obj)"; fi; ;; \
	  esac; \
	done || true; \
	if [ "$$_w7hh4_swapped" = "1" ]; then \
	  if cp -f "$$_w7hh4_backup" "$$_w7hh4_target"; then \
	    rm -f "$$_w7hh4_backup"; \
	    echo "[W7HH4] restored original conda-stock $$_w7hh4_target from backup (self-link rc=$$_w7hh_selflink_rc)"; \
	  else \
	    echo "[W7HH4] CRITICAL WARNING: failed to restore $$_w7hh4_target from $$_w7hh4_backup -- BUILD_PREFIX flexlink.exe may still be the zig-patched swap-in; manual inspection required"; \
	  fi; \
	fi; \
	echo "[W7HH-VERIFY] grep mingw64 $(FLEXDLL_SOURCE_DIR)/version.ml (runs regardless of self-link exit status $$_w7hh_selflink_rc):"; \
	grep -n 'mingw64' "$(FLEXDLL_SOURCE_DIR)/version.ml" 2>&1 || echo "[W7HH-VERIFY] WARNING: no 'mingw64' match (or version.ml missing) -- MIN64CC override did NOT land in the compiled artifact"; \
	echo "[W7HH3-VERIFY] binary-level check of the COMPILED $(FLEXDLL_SOURCE_DIR)/flexlink.exe (not just source .ml) -- runs regardless of self-link exit status $$_w7hh_selflink_rc:"; \
	if [ -f "$(FLEXDLL_SOURCE_DIR)/flexlink.exe" ]; then \
	  (strings "$(FLEXDLL_SOURCE_DIR)/flexlink.exe" 2>/dev/null || grep -a . "$(FLEXDLL_SOURCE_DIR)/flexlink.exe") | grep -i 'mingw32\|zig' | head -10 || echo "[W7HH3-VERIFY] WARNING: no 'mingw32'/'zig' string found in the compiled binary"; \
	else \
	  echo "[W7HH3-VERIFY] WARNING: $(FLEXDLL_SOURCE_DIR)/flexlink.exe does not exist (self-link produced no output)"; \
	fi; \
	echo "============ W7GG DIAGNOSTIC: resulting flexlink.exe machine type ============"; \
	file "$(FLEXDLL_SOURCE_DIR)/flexlink.exe" 2>/dev/null || echo "  (file probe unavailable)"; \
	echo "=============================================================================="; \
	echo "[W7HH12] NUKE=$(NUKE_ZIG_HOST_CRT2_CACHE) _w7gg_oc='$${_w7gg_oc:-<empty>}' -> LINKFLAGS='$${_w7hh10_linkflags:-<empty>}'"; \
	exit $$_w7hh_selflink_rc
	$(LN) $(FLEXDLL_SOURCE_DIR)/flexlink.exe flexlink.opt.exe
	$(LN) flexlink.opt.exe flexlink.byte.exe
	cp flexlink.byte.exe $(BYTE_BINDIR)/flexlink
	cd $(BYTE_BINDIR) && $(LN) flexlink flexlink.exe 2>/dev/null || true
	cp $(addprefix $(FLEXDLL_SOURCE_DIR)/, $(FLEXDLL_OBJECTS)) $(ROOTDIR)
	cp flexlink.opt.exe $(OPT_BINDIR)/flexlink
	cd $(OPT_BINDIR) && $(LN) flexlink flexlink.exe 2>/dev/null || true

# CRITICAL: INSTALLING=1 makes VPATH conditional skip in Makefile.cross line 43
# Without this, recursive makes re-include Makefile.cross and set VPATH := + $(VPATH)
# causing Make to find OLD unix.cmxa from native stdlib before fresh build in otherlibs/
INSTALL_OVERRIDES=build_ocamldoc=false WITH_DEBUGGER= OCAMLRUN=ocamlrun INSTALLING=1 VPATH= SUPPORTS_SHARED_LIBRARIES=true

.PHONY: installcross
installcross:
	# Create dummy files to keep `install` happy
	touch \
	  $(addprefix toplevel/, \
	    $(foreach ext,cmi cmt cmti cmx, native/nat__dummy__.$(ext)) \
	      all__dummy__.cmx topstart.o native/tophooks.cmi)
	# Only create symlinks if binaries don't exist (Stage 3 builds real binaries)
	test -f lex/ocamllex.opt$(EXE) || $(LN) `command -v ocamllex` lex/ocamllex.opt$(EXE)
	test -f yacc/ocamlyacc.opt$(EXE) || $(LN) `command -v ocamlyacc` yacc/ocamlyacc.opt$(EXE)
	# NOTE: Do NOT delete files from NATIVE_STDLIB here!
	# NATIVE_STDLIB is the installed native compiler that gets packaged.
	# Deleting unix.cma/.cmi from there breaks the native package.
	# VPATH pollution is prevented by INSTALLING=1 VPATH= in INSTALL_OVERRIDES.
	# Real installation (VPATH= is in INSTALL_OVERRIDES to propagate to recursive sub-makes)
	$(MAKE) install $(INSTALL_OVERRIDES)
