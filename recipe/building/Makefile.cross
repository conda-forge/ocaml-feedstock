# Recipes to build a cross compiler (_not_ cross-compiling the compiler), aka
# generating code that will run on `target`, assuming that a non-cross OCaml
# compiler (so targetting our build machine) of the same version is available in
# $PATH

# HAS_ZSTD gates all zstd linkage in this file. It defaults from the
# OCAML_HAS_ZSTD environment variable that recipe.yaml's has_zstd context key
# sets, and to 1 (zstd enabled) when invoked outside of a recipe build.
HAS_ZSTD ?= $(or $(OCAML_HAS_ZSTD),1)

# As the cross compiler will be linked with the _build_ version of
# libcomprmarsh, we cannot rely on the detection of zstd done during `configure`
# (as it would have detected the _target_ version). So we recover the flags to
# link with zstd of the non-cross compiler.
# ZSTD_LIBS can be overridden from command line for cross-compilation (to use HOST libs)
# If not provided, fall back to native ocamlopt's compression_c_libraries config.
# Empty when HAS_ZSTD=0, so no -lzstd is ever emitted for a zstd-free target.
ZSTD_LIBS ?= $(if $(filter 0,$(HAS_ZSTD)),,$(shell ocamlopt -config-var compression_c_libraries))
HOST_ZSTD_LIBS=ZSTD_LIBS=$(ZSTD_LIBS)

# TARGET_ZSTD_LIBS is for linking target-arch shared libraries (libcamlrun_shared.so)
# This points to a conda env with target-arch zstd installed via --subdir.
# Empty automatically when ZSTD_LIBS is empty (HAS_ZSTD=0).
TARGET_ZSTD_LIBS ?= $(ZSTD_LIBS)

# The build system adds various include directories which pertain to the current
# tree, including -I runtime, which is necessary for -custom executables.
# ocamltest is always a -custom executable, but some others (ocamldoc; the
# debugger, etc.) are only -custom in specific circumstances. It is therefore
# fiddly to change this in the main build system, so we perform a slightly
# different trick by ensuring that "+" is the first entry in VPATH. This will
# put the host compiler's standard library (and consequently its runtime
# objects) well above the .a files found with -I runtime. For now, this seems
# the least nefarious way of ensuring that the bytecode compiler has the C
# headers in runtime/caml available without breaking builds with an external
# ocamlopt.
# CRITICAL: Only set VPATH when NOT installing. During install, VPATH causes
# Make to find OLD unix.cmxa from native stdlib before the freshly built one
# in otherlibs/unix/. Set INSTALLING=1 during installcross to skip this.
ifneq ($(INSTALLING),1)
VPATH := + $(VPATH)
endif

# Export OCAMLLIB (will be set for specific targets that need it)
export OCAMLLIB

# SAK_CC and SAK_LINK should be set to build-machine compiler when cross-compiling
# SAK is a build tool that must run on the BUILD machine, not the TARGET
# Default to CC if SAK_CC is not defined (native build case)
SAK_CC ?= $(CC)
# SAK_CFLAGS: CFLAGS for BUILD machine (sak runs on build, not target)
# Must NOT contain target-specific flags like -mtune=power8
SAK_CFLAGS ?= $(CFLAGS)
SAK_LINK ?= $(SAK_CC) $(OC_LDFLAGS) $(LDFLAGS) $(OUTPUTEXE)$(1) $(2)

# Override SAK_BUILD to use SAK_CC/SAK_CFLAGS instead of CC/CFLAGS for cross-compilation
# sak is a build tool that must run on the BUILD machine
SAK_BUILD = $(SAK_LINK) $(OC_CFLAGS) $(SAK_CFLAGS) $(OC_CPPFLAGS) $(CPPFLAGS)

# CROSS_CC/CROSS_AR must be set on command line for cross-compilation.
# These are passed through to sub-makes for C libraries (otherlibs).
# We can't use CC="$(CC)" because $(CC) gets value from Makefile.config (BUILD compiler),
# not the command-line override (TARGET cross-compiler).
CROSS_CC ?= $(CC)
CROSS_AR ?= $(AR)

# CROSS_MKLIB: wrapper for ocamlmklib that uses CROSS_CC/CROSS_AR.
# ocamlmklib has Config.ar and Config.mkdll baked in from compile time (BUILD tools).
# For cross-compilation, we need a wrapper that uses TARGET cross-tools.
# Set to cross-ocamlmklib.sh on command line; defaults to ocamlmklib for native builds.
CROSS_MKLIB ?= ocamlmklib

# CAMLOPT can be overridden on command line for cross-compilation.
# Stage 2 (crossopt): use native ocamlopt from PATH
# Stage 3 (crosscompiledopt): use cross-compiler from _cross/bin to produce target binaries
CAMLOPT ?= ocamlopt

# Command prefix for in-tree binaries that may be target-arch (empty = run
# them directly). Set to run-target.sh, which wraps in qemu only when the
# binary's ELF machine differs from the build machine's.
RUN_TARGET ?=

# CROSS_OVERRIDES for sub-makes.
# CC/AR must be cross-compiler for C stub libraries in otherlibs.
# CFLAGS/LDFLAGS must include target-specific flags (e.g., -isysroot for macOS ARM64)
# On macOS, -isysroot is needed in both CFLAGS and LDFLAGS for proper SDK linkage
# CAMLC=ocamlc uses the installed ocamlc from PATH (required for dynlink, otherlibs)
# MKLIB=$(CROSS_MKLIB) uses cross-ocamlmklib.sh wrapper for cross-compilation:
#   - The native ocamlmklib has BUILD linker baked in (Config.mkdll, Config.ar)
#   - The wrapper script uses CROSS_CC/CROSS_AR for proper cross-compilation
#   - For native builds, CROSS_MKLIB defaults to ocamlmklib
# MKEXE/MKDLL: Must include -isysroot for macOS ARM64 cross-compilation
#   - OCaml's stdlib/Makefile uses $(MKEXE) directly without $(LDFLAGS)
#   - Without explicit pass-through, linker finds wrong SDK
CROSS_MKEXE ?= $(MKEXE)
CROSS_MKDLL ?= $(MKDLL)

# configure's shared-library probe is unreliable when cross-compiling, so the
# cross toolchain's dll linker is passed explicitly. Empty when the toolchain
# has no dll linker (MSVC links through flexlink); the sub-make's own MKDLL
# must win in that case, so the whole override drops out.
CROSS_SHARED_LIB_VARS = $(if $(CROSS_MKDLL),MKDLL='$(CROSS_MKDLL)' SUPPORTS_SHARED_LIBRARIES=true)

CROSS_OVERRIDES=OCAMLRUN=ocamlrun NEW_OCAMLRUN=ocamlrun \
  BOOT_OCAMLLEX=ocamllex OCAMLYACC=ocamlyacc \
  CAMLC=ocamlc MKLIB="$(CROSS_MKLIB)" \
  CC="$(CROSS_CC)" AR="$(CROSS_AR)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" \
  MKEXE="$(CROSS_MKEXE)" MKDLL="$(CROSS_MKDLL)"

# CROSS_OTHERLIBS_OVERRIDES: same as CROSS_OVERRIDES
CROSS_OTHERLIBS_OVERRIDES = $(CROSS_OVERRIDES)

# NATIVE_AS/NATIVE_CC: Passed from build-cross-compiler.sh, saved before CONDA_OCAML_* override
# These are the native (BUILD machine) assembler/compiler for building native tools
# NATIVE_ASM is the assembler command (e.g., "clang -c" on macOS, "as" on Linux)
NATIVE_AS ?= as
NATIVE_ASM ?= $(NATIVE_AS)
NATIVE_CC ?= $(CC)

# NATIVE_OVERRIDES: For building NATIVE tools (ocamlc.opt, ocamlopt.opt, profiling.cmx)
# These run on the BUILD machine and must use BUILD tools, NOT cross-compiler.
# Does NOT include CC/AR overrides - uses defaults from Makefile.config (BUILD compiler)
# NOTE: CONDA_OCAML_AS/CC are set as ENVIRONMENT VARIABLES at call sites (lines 207, 219)
# NOT here, because NATIVE_ASM contains spaces (e.g., "clang -c") which breaks
# make variable passing (spaces split into separate args, -c becomes invalid option)
NATIVE_OVERRIDES=OCAMLRUN=ocamlrun NEW_OCAMLRUN=ocamlrun \
  BOOT_OCAMLLEX=ocamllex OCAMLYACC=ocamlyacc \
  CAMLC=ocamlc MKLIB="$(CROSS_MKLIB)"

# NATIVE_COMPILER_OVERRIDES: For building native compilers with native tools
# CRITICAL: Does NOT include CC="$(CROSS_CC)" - we need BUILD CC for native tools
NATIVE_COMPILER_OVERRIDES=$(NATIVE_OVERRIDES) CAMLC=ocamlc CAMLOPT=$(CAMLOPT) \
  BEST_OCAMLC=ocamlc BEST_OCAMLOPT=$(CAMLOPT) BEST_OCAMLLEX=ocamllex

# CAMLOPT is now a variable that can be overridden from command line
CROSS_COMPILER_OVERRIDES=$(CROSS_OVERRIDES) CAMLC=ocamlc CAMLOPT=$(CAMLOPT) \
  BEST_OCAMLC=ocamlc BEST_OCAMLOPT=$(CAMLOPT) BEST_OCAMLLEX=ocamllex

# STDLIB_CMI_PIN_INTREE selects which ocamlc writes the stdlib and
# compilerlibs .cmi files during crossopt. Marshal compression is decided by
# the RUNTIME that executes the compiler (runtime/extern.c, gated by
# HAS_ZSTD), not by the compiler's own Config: a bare CAMLC=ocamlc resolves
# through PATH to a zstd-enabled ocamlc running under its own #! shebang's
# ocamlrun, and the .cmi it writes carry the COMPRESSED marshal magic
# 0x8495A6BD. A target built --without-zstd cannot decompress that and
# fails with "Corrupted compiled interface". When this knob is 1, the pins
# below (NATIVE_L1A_PIN, NATIVE_CAMLC_PIN, NATIVE_OTHERLIBS_CAMLC_PIN,
# CROSS_CAMLC_PIN) redirect CAMLC to explicit in-tree binaries, prefixed
# with the in-tree runtime/ocamlrun where the target is a bytecode image,
# and NATIVE_L1A_PIN links the BUILD-arch compilers with a decompress-only
# stub, so every .cmi they write is plain. Defaults off; build.sh sets it
# to 1 for targets configured --without-zstd.
STDLIB_CMI_PIN_INTREE ?= 0

# CROSS_COMPILERLIBS_OVERRIDES: CAMLC must match the compiler that actually
# wrote stdlib.cmi. When STDLIB_CMI_PIN_INTREE=1, the crossopt recipe's
# zstd-free stdlib rebuild (below) rewrites stdlib.cmi with the in-tree
# ocamlc; if compilerlibs were then built with the bare PATH ocamlc instead,
# the two ocamlc binaries would disagree on the interface stamp and fail
# with "inconsistent assumptions over interface Stdlib".
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
# CAMLC here is a bytecode image; running it bare resolves its own #!
# shebang's ocamlrun, which is the zstd-enabled one, so it is prefixed with
# the in-tree runtime/ocamlrun to force the zstd-free runtime and get plain
# .cmi. CAMLOPT is a NATIVE .opt binary with its own linked runtime and must
# NOT get an ocamlrun prefix.
CROSS_COMPILERLIBS_OVERRIDES=$(CROSS_OVERRIDES) CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)" \
  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt$(EXE) $(STDLIBFLAGS)"
else
CROSS_COMPILERLIBS_OVERRIDES=$(CROSS_OVERRIDES) CAMLC=ocamlc \
  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt$(EXE) $(STDLIBFLAGS)"
endif

CROSSCOMPILED_COMPILERLIBS_OVERRIDES=$(CROSS_OVERRIDES) CAMLC=ocamlc \
  CAMLOPT="$(CAMLOPT) $(STDLIBFLAGS)"

# NATIVE_CAMLC_PIN: crosscompiledopt's `-C stdlib all` step below resolves
# CAMLC=ocamlc through bare PATH by default, which is the zstd-enabled
# bootstrap ocamlc: it rewrites stdlib.cma compressed and undoes the
# zstd-free stdlib crossopt already built. A --without-zstd runtime then
# fails -output-complete-exe with "input_value: compressed object, cannot
# decompress". Pin CAMLC to the in-tree ocamlc, prefixed with the in-tree
# runtime/ocamlrun since a bare bytecode ocamlc otherwise runs under its own
# #! shebang's zstd-enabled ocamlrun. Appended, not substituted, so
# last-assignment-wins lets it override CAMLC=ocamlc. Empty (no-op) on every
# other platform.
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
NATIVE_CAMLC_PIN=CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)"
else
NATIVE_CAMLC_PIN=
endif

# NOZSTD_STUB_OBJ: BUILD-arch object defining a decompress-only
# caml_zstd_initialize. utils/compression.ml calls it at startup. It installs
# the intern decompression hook exactly as runtime/zstd.c does, so the
# BUILD-arch compilers read compressed .cmi/.cmx written by ordinary
# compilers, but returns false so they still write plain marshal data that the
# zstd-free target can read. Kept outside runtime/ so no runtime rule touches
# it.
NOZSTD_DIR = $(abspath $(ROOTDIR))/_nozstd
NOZSTD_STUB_OBJ = $(NOZSTD_DIR)/nozstd_stub.o
# BUILD-arch zstd for the stub's decompressor, independent of HAS_ZSTD (which
# describes the target). build.sh passes both on the STDLIB_CMI_PIN_INTREE path.
NOZSTD_STUB_ZSTD_CFLAGS ?=
NOZSTD_STUB_ZSTD_LIBS ?= -lzstd
# ocamlopt link flags for NOZSTD_STUB_ZSTD_LIBS: -l to -cclib, the rest to -ccopt.
NOZSTD_STUB_LINK_FLAGS = $(foreach f,$(NOZSTD_STUB_ZSTD_LIBS),$(if $(filter -l%,$(f)),-cclib $(f),-ccopt $(f)))

# NATIVE_L1A_PIN: applied at the crossopt step that links ocamlc.opt,
# ocamlopt.opt and the native tools. These are BUILD-arch executables, so
# CAMLOPT/OCAMLOPT/BEST_OCAMLOPT are the BUILD compiler from PATH
# ($(CAMLOPT), ocamlopt from build.sh) plus $(STDLIBFLAGS), so they compile
# and link against the in-tree stdlib .cmi and the BUILD-arch work-tree
# stdlib.cmxa built just before the link. NOZSTD_DIR comes first in the -I
# order and holds the BUILD libasmrun*, since ./stdlib's copy is target-arch
# at link time. CAMLC is prefixed with the in-tree
# runtime/ocamlrun for the same reason as CROSS_COMPILERLIBS_OVERRIDES above.
# COMPRESSED_MARSHALING_FLAGS replaces -lcomprmarsh (baked into
# compilerlibs/ocamlcommon.cmxa) with NOZSTD_STUB_OBJ plus the BUILD libzstd,
# so the linked compilers read compressed .cmi/.cmx but write plain ones for
# the zstd-free target. build.sh passes
# its own COMPRESSED_MARSHALING_FLAGS on the outer make command line, which
# reaches the inner $(MAKE) through MAKEFLAGS; GNU make reads MAKEFLAGS
# before the inner command line, so this explicit argument is assigned last
# and wins, as the CAMLOPT pins here already do over build.sh's CAMLOPT.
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
NATIVE_L1A_PIN=CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)" \
  CAMLOPT="$(CAMLOPT) -I $(NOZSTD_DIR) $(STDLIBFLAGS)" \
  OCAMLOPT="$(CAMLOPT) -I $(NOZSTD_DIR) $(STDLIBFLAGS)" \
  BEST_OCAMLOPT="$(CAMLOPT) -I $(NOZSTD_DIR) $(STDLIBFLAGS)" \
  COMPRESSED_MARSHALING_FLAGS="-cclib $(NOZSTD_STUB_OBJ) $(NOZSTD_STUB_LINK_FLAGS)"
# ocamltoolsopt.opt links against the stdlib.cmxa in the work tree, which is
# BUILD-arch only around the native-compiler link, so it is built there.
NATIVE_L1A_TOOLS=ocamltoolsopt.opt
else
NATIVE_L1A_PIN=
NATIVE_L1A_TOOLS=
endif

# GNU make silently deletes toplevel/byte/*.cmi as chained-implicit-rule
# intermediates: upstream Makefile:400-402 defines `toplevel/byte/%.cmi:
# toplevel/%.cmi` which fires only as a side effect of building
# compilerlibs/ocamltoplevel.cma, and the files are never declared
# .PRECIOUS or .SECONDARY. But `make install` (upstream Makefile:2717-2719)
# globs toplevel/byte/*.cmi and fails when they are gone. Restore them from
# the toplevel/ root copies, which are written by the pinned zstd-free CAMLC.
# Guarded to OCAML_TOPLEVEL_BYTE_CMI_RESTORE (linux-s390x) so green platforms,
# whose toplevel/byte .cmi survive, are untouched. OCAML_TOPLEVEL_BYTE_CMI_RESTORE
# is exported from build.sh (not STDLIB_CMI_PIN_INTREE): the installcross call
# sites never receive STDLIB_CMI_PIN_INTREE as a make argument, and reusing it
# here would also flip CAMLC/CAMLOPT pins across the whole install phase.
ifeq "$(OCAML_TOPLEVEL_BYTE_CMI_RESTORE)" "1"
TOPLEVEL_BYTE_CMI_RESTORE=cp toplevel/topmain.cmi toplevel/trace.cmi toplevel/topeval.cmi toplevel/byte/
else
TOPLEVEL_BYTE_CMI_RESTORE=true
endif

# NATIVE_OTHERLIBS_CAMLC_PIN: the crossopt otherlibs allopt/all sub-makes
# (unix/str/dynlink/runtime_events/systhreads) pin CAMLOPT to the in-tree
# ocamlopt.opt but leave CAMLC unpinned, so CAMLC falls through
# CROSS_OTHERLIBS_OVERRIDES/CROSS_OVERRIDES to the bare PATH ocamlc, which
# writes COMPRESSED .cmi that the in-tree ocamlopt.opt then rejects as
# corrupted. ocamlc.opt is a NATIVE binary with its own zstd-free linked
# runtime, so it needs no ocamlrun prefix here. Must be appended AFTER
# CROSS_OTHERLIBS_OVERRIDES on each command line so this pin's CAMLC wins
# over the override's CAMLC=ocamlc (make command-line assignments: last
# wins).
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
NATIVE_OTHERLIBS_CAMLC_PIN=CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlc.opt"
else
NATIVE_OTHERLIBS_CAMLC_PIN=
endif

# CROSS_CAMLC_PIN: applied only at the crossopt ocamllex/ocaml steps, never
# at crosscompiledopt's equivalent steps - those already carry their own
# CAMLC="ocamlc $(STDLIBFLAGS)". After the zstd-free stdlib rebuild and the
# purges below invalidate the compilerlibs .cmi built earlier in this
# recipe, ocamllex/ocaml are rebuilt via CROSS_COMPILER_OVERRIDES, whose
# CAMLC=ocamlc resolves through bare PATH with no STDLIBFLAGS - i.e. against
# PATH's stdlib, not the in-tree one just rebuilt. This pin redirects CAMLC
# to the in-tree ocamlc, prefixed with the in-tree runtime/ocamlrun for the
# same reason as the pins above.
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
CROSS_CAMLC_PIN=CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)"
else
CROSS_CAMLC_PIN=
endif

ifeq "$(BOOTSTRAPPING_FLEXDLL)" "true"
# Declare flexlink to be an 'old' file, so that make doesn't try to rebuild it
# with the build rules in `Makefile`; its build is driven by the `cross-flexdll`
# recipe provided here instead
OLDS := -o $(BYTE_BINDIR)/flexlink$(EXE)
else
OLDS :=
endif

# The compiler libs that should be rebuilt for target (they are first built for
# host as part of the .opt compilers)
CROSSCOMPILERLIBS := $(addprefix compilerlibs/,$(addsuffix .cmxa,\
    ocamlcommon ocamlmiddleend ocamlbytecomp ocamloptcomp ocamltoplevel))

# CROSSCOMPILERLIBS_CMI: the .cmi counterparts of CROSSCOMPILERLIBS, used
# below to purge stale compilerlibs .cmi after the stdlib they were compiled
# against gets rebuilt. Each <lib>_NCOBJS lists native object targets (.cmx)
# and does not cover interface-only modules (a .mli with no corresponding
# .ml), so it is unioned with <lib>_CMI_FILES, which upstream derives
# directly from each library's .mli list. $(sort ...) dedupes the union.
CROSSCOMPILERLIBS_NCOBJS := $(ocamlcommon_NCOBJS) $(ocamlmiddleend_NCOBJS) \
    $(ocamlbytecomp_NCOBJS) $(ocamloptcomp_NCOBJS) $(ocamltoplevel_NCOBJS)
CROSSCOMPILERLIBS_LIBNAMES := ocamlcommon ocamlmiddleend ocamlbytecomp \
    ocamloptcomp ocamltoplevel
CROSSCOMPILERLIBS_CMI := $(sort \
    $(patsubst %.cmx,%.cmi,$(filter %.cmx,$(CROSSCOMPILERLIBS_NCOBJS))) \
    $(foreach lib,$(CROSSCOMPILERLIBS_LIBNAMES),$($(lib)_CMI_FILES)))

# RUNTIME_VARS: variables that must be passed to runtimeopt for cross-compilation
# ARCH selects the correct .S file (arm64.S vs amd64.S)
# AS/ASPP/CC are the cross-toolchain for assembling/compiling
# SAK_CC/SAK_CFLAGS are for the sak tool which must run on BUILD machine
# SAK_LINK uses $$ escaping so $(1) and $(2) survive to the sub-make's $(call SAK_LINK,...)
# Values must be quoted because ASPP contains spaces (e.g., "gcc -c")
# runtime_ASM_OBJECTS is hardcoded at configure time (Makefile.build_config),
# must override to use correct $(ARCH).o for cross-compilation
# LDFLAGS passed here is for the TARGET cross-linker (e.g., -fuse-ld=lld on macOS)
# SAK_LINK uses $(SAK_LDFLAGS) NOT $(LDFLAGS) - SAK runs on BUILD machine, not TARGET
# AR must be passed to create archives with correct format (llvm-ar on macOS for ld64 compat)
RUNTIME_VARS = ARCH=$(ARCH) AR='$(AR)' AS='$(AS)' ASPP='$(ASPP)' CC='$(CC)' LDFLAGS='$(LDFLAGS)' \
  SAK_CC='$(SAK_CC)' SAK_CFLAGS='$(SAK_CFLAGS)' \
  'SAK_LINK=$(SAK_CC) $(SAK_LDFLAGS) $$(OUTPUTEXE)$$(1) $$(2)' \
  runtime_ASM_OBJECTS='runtime/$(ARCH).o'

# BYTECODE_RUNTIME_VARS: for building bytecode runtime on BUILD machine (not cross-compiled)
# ocamlrun must run on the BUILD machine, so use BUILD compiler (not cross-compiler)
# The x86_64 ocamlrun from Stage 1 (_native/bin) is available via PATH
# SAK tool also runs on BUILD machine
# SAK_LDFLAGS: linker flags for BUILD machine (e.g., -fuse-ld=lld on macOS)
# SAK_AR: archiver for BUILD machine (llvm-ar on macOS for ld64 compatibility)
SAK_LDFLAGS ?=
SAK_AR ?= $(AR)
BYTECODE_RUNTIME_VARS = \
  SAK_CC='$(SAK_CC)' SAK_CFLAGS='$(SAK_CFLAGS)' \
  'SAK_LINK=$(SAK_CC) $(SAK_LDFLAGS) $$(OUTPUTEXE)$$(1) $$(2)'

.PHONY: crossopt
ifeq "$(BOOTSTRAPPING_FLEXDLL)" "true"
crossopt: cross-flexdll
	# Build bytecode runtime with BUILD compiler (ocamlrun runs on BUILD machine)
	# SAK_* override MAKEFLAGS to prevent cross-compiler flags (e.g., -mtune=power8)
	$(MAKE) runtime-all CC=$(SAK_CC) CFLAGS="$(SAK_CFLAGS)" LDFLAGS="$(SAK_LDFLAGS)" AR="$(SAK_AR)" $(BYTECODE_RUNTIME_VARS) $(OLDS)
else
crossopt:
	# Build bytecode runtime with BUILD compiler (ocamlrun runs on BUILD machine)
	# SAK_* override MAKEFLAGS to prevent cross-compiler flags (e.g., -mtune=power8)
	$(MAKE) runtime-all CC=$(SAK_CC) CFLAGS="$(SAK_CFLAGS)" LDFLAGS="$(SAK_LDFLAGS)" AR="$(SAK_AR)" $(BYTECODE_RUNTIME_VARS) $(OLDS)
endif
	# When STDLIB_CMI_PIN_INTREE=1, build the in-tree ocamlc now and defer
	# the other bytecode tools until after the stdlib rebuild below settles,
	# so those tools' .cmi are written by the zstd-free in-tree ocamlc
	# instead of the zstd-enabled PATH ocamlc used by the single command on
	# every other target.
ifeq ($(STDLIB_CMI_PIN_INTREE),1)
	$(MAKE) ocamlc $(CROSS_COMPILER_OVERRIDES) $(OLDS)
else
	$(MAKE) ocamlc $(TOOLS_BYTECODE_TARGETS) expunge$(EXE) \
	  $(CROSS_COMPILER_OVERRIDES) $(OLDS)
endif
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
	# Bytecode ocamlopt: links only compilerlibs/{ocamlcommon,ocamloptcomp}.cma
	# and has no stdlib.cmxa dependency.
	$(MAKE) ocamlopt $(CROSS_COMPILER_OVERRIDES) $(OLDS)
endif
	# Build stdlib directly (not via library or library-cross targets)
	# - library depends on ocamlc which triggers rebuild
	# - library-cross sets OCAMLRUN=../runtime/ocamlrun which doesn't work for cross
	# - COMPILER_DEPS= disables the file dependency check on ../ocamlc
	# - CAMLC=ocamlc uses the installed ocamlc from PATH; when
	#   STDLIB_CMI_PIN_INTREE=1 the block below attempts a fail-over rebuild
	#   via the in-tree runtime instead
	$(MAKE) -C stdlib all CAMLC=ocamlc COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS)
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
	# Retry the stdlib build with CAMLC pointed at the in-tree runtime plus
	# in-tree ocamlc, instead of the bare PATH ocamlc used above, so the
	# .cmi it writes are plain rather than zstd-compressed (see the
	# STDLIB_CMI_PIN_INTREE comment above CROSS_COMPILERLIBS_OVERRIDES for
	# why the executing runtime, not the compiler, decides this). The
	# offset12 probe below reads the 4-byte marshal magic at byte offset 12
	# of stdlib.cmi: 8495a6be/8495a6bf is a plain (uncompressed) interface,
	# 8495a6bd is compressed. A compressed result here means the pin did
	# not take effect, so it is treated as fatal rather than silently
	# reverting - reverting would let the build continue and only surface
	# as a confusing "inconsistent assumptions" CRC error much later.
	@_rt="$(abspath $(ROOTDIR))/runtime/ocamlrun"; _oc="$(abspath $(ROOTDIR))/ocamlc"; \
	if [ -x "$$_rt" ] && [ -f "$$_oc" ]; then \
	  rm -f stdlib/*.cmi stdlib/*.cmo stdlib/*.cma; \
	  if $(MAKE) -C stdlib all COMPILER_DEPS= $(CROSS_OVERRIDES) CAMLC="$(RUN_TARGET) $$_rt $$_oc" $(OLDS); then \
	    _m=$$(od -An -tx1 -j12 -N4 stdlib/stdlib.cmi 2>/dev/null | tr -d ' \n'); \
	    echo "[stdlib-zstd-free] rebuilt stdlib.cmi offset12=$$_m"; \
	    if [ "$$_m" = "8495a6be" ] || [ "$$_m" = "8495a6bf" ]; then \
	      echo "[stdlib-zstd-free] stdlib written plain via the in-tree runtime"; \
	    else \
	      echo "[stdlib-zstd-free] FATAL: stdlib.cmi magic is $$_m, expected 8495a6be or 8495a6bf (plain)"; \
	      echo "[stdlib-zstd-free] FATAL: 8495a6bd would mean the in-tree ocamlc still wrote a"; \
	      echo "[stdlib-zstd-free] FATAL: COMPRESSED interface - the pin did not take effect"; \
	      exit 1; \
	    fi; \
	  else \
	    echo "[stdlib-zstd-free] zstd-free stdlib build failed - reverting to default toolchain"; \
	    rm -f stdlib/*.cmi stdlib/*.cmo stdlib/*.cma; \
	    $(MAKE) -C stdlib all CAMLC=ocamlc COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS); \
	  fi; \
	else \
	  echo "[stdlib-zstd-free] in-tree runtime or ocamlc missing (_rt=$$_rt _oc=$$_oc) - keeping default build"; \
	fi
	# Broader diagnostic only (non-fatal): scan built archives for any
	# COMPRESSED marshal object (magic byte sequence 84 95 a6 bd). The
	# probe above is fatal because it proves whether the pin took effect on
	# stdlib.cmi specifically; a compressed object surviving in one of
	# these archives would be STALE from an earlier unpinned build (the
	# zstd-free runtime cannot itself emit compressed output), so this scan
	# only warns.
	@for _af in stdlib/stdlib.cma otherlibs/dynlink/dynlink.cma compilerlibs/*.cma; do \
	  if [ -f "$$_af" ]; then \
	    _n=$$(od -An -tx1 "$$_af" 2>/dev/null | tr -d ' \n' | grep -o 8495a6bd | wc -l | tr -d ' '); \
	    echo "[stdlib-zstd-free] archive scan: $$_af compressed_objects=$$_n"; \
	    if [ "$$_n" -gt 0 ]; then \
	      echo "[stdlib-zstd-free] WARNING: $$_af contains $$_n stale compressed marshal object(s)"; \
	    fi; \
	  fi; \
	done; \
	true
	# After the zstd-free stdlib rebuild above changes stdlib.cmi's CRCs,
	# the compilerlibs .cmi built by the ocamlc step earlier in this recipe
	# are stale. Purge them so the CAMLC-pinned ocamllex/ocaml rebuilds just
	# below regenerate them against the new stdlib instead of colliding
	# with the stale ones.
	rm -f $(CROSSCOMPILERLIBS_CMI)
	rm -f $(ocamlcommon_NCOBJS) $(ocamlmiddleend_NCOBJS) \
	  $(ocamlbytecomp_NCOBJS) $(ocamloptcomp_NCOBJS) \
	  $(ocamltoplevel_NCOBJS) $(CROSSCOMPILERLIBS)
	# The purge above only covers the five CROSSCOMPILERLIBS_CMI members,
	# but every .cmi anywhere in the work tree compiled before the stdlib
	# rebuild is equally stale - for example expunge.cmi, a standalone
	# bytecode tool that is not a member of any of the five compilerlibs
	# libraries and so is not covered above. Sweep every remaining
	# work-tree .cmi except: ./stdlib (the freshly rebuilt ones this whole
	# fix depends on - must survive), ./flexdll (vendored third-party),
	# ./.git and ./_logs (not build artifacts), and ./tools (tools/*.cmx,
	# e.g. profiling.cmx, are compiled against the same stdlib as the
	# unpinned CAMLOPT paths elsewhere in this recipe; deleting their .cmi
	# here would let them be regenerated against a different stdlib than
	# their paired .cmx, reproducing the same inconsistency this sweep
	# exists to prevent). -prune stops find from descending into an
	# excluded directory at all, so this is a directory-level exclusion,
	# not a filename filter. Do NOT change `-exec rm -f {} +` to `-delete`:
	# GNU find's -delete implies -depth, under which -prune has no effect,
	# which would silently defeat the ./stdlib exclusion.
	find . \( -path ./stdlib -o -path ./flexdll -o -path ./.git -o -path ./_logs -o -path ./tools \) -prune -o -name '*.cmi' -exec rm -f {} + >/dev/null
endif
	$(MAKE) ocamlyacc $(CROSS_OVERRIDES) $(OLDS)
	$(MAKE) ocamllex $(CROSS_COMPILER_OVERRIDES) $(OLDS) $(CROSS_CAMLC_PIN)
	$(MAKE) ocaml $(CROSS_COMPILER_OVERRIDES) $(OLDS) $(CROSS_CAMLC_PIN)
ifeq ($(STDLIB_CMI_PIN_INTREE),1)
	# The compilerlibs .cmi rebuilt by the purge and the CAMLC-pinned
	# ocamllex/ocaml steps just above are zstd-free only once this point is
	# reached; before it, driver/*.cmi and utils/*.cmi are still the
	# zstd-compressed ones written by the bootstrap ocamlc. This must run
	# before otherlibs because ocamlmklib is one of TOOLS_BYTECODE_TARGETS
	# and otherlibs depends on it. $(STDLIBFLAGS) is appended to CAMLC (on
	# top of the in-tree runtime/ocamlc prefix) because the generic
	# %.cmi: %.mli rule invokes $(CAMLC) verbatim with no stdlib flags from
	# CROSS_COMPILER_OVERRIDES, so without it this in-tree ocamlc would
	# resolve stdlib from its own baked-in Config.standard_library
	# (PREFIX/lib/ocaml) instead of the in-tree one.
	$(MAKE) $(TOOLS_BYTECODE_TARGETS) expunge$(EXE) \
	  $(CROSS_COMPILER_OVERRIDES) CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)" $(OLDS)
endif
	$(MAKE) dynlink-all $(CROSS_OVERRIDES) $(OLDS)
	$(MAKE) -C otherlibs all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS)
	$(MAKE) runtimeopt $(RUNTIME_VARS) $(CROSS_SHARED_LIB_VARS) $(OLDS)
	# CRITICAL FIX: Rebuild bytecode runtime libraries for TARGET architecture
	# runtime-all above builds libcamlrun for BUILD (x86_64), but -output-complete-exe
	# links libcamlrun into TARGET executables, so it must be TARGET arch.
	# Build all static library variants (install expects all four):
	#   libcamlrun.a   - standard (from *.b.o)
	#   libcamlrund.a  - debug (from *.bd.o)
	#   libcamlruni.a  - instrumented (from *.bi.o)
	#   libcamlrun_pic.a - PIC (from *.bpic.o)
	# Also build shared library using TARGET_ZSTD_LIBS (target-arch zstd from conda env)
	@echo "=== Rebuilding bytecode runtime libraries for TARGET architecture ==="
	rm -f runtime/libcamlrun*.a runtime/libcamlrun_shared.so runtime/*.b.o runtime/*.bd.o runtime/*.bi.o runtime/*.bpic.o
	$(MAKE) runtime/libcamlrun.a runtime/libcamlrund.a runtime/libcamlruni.a runtime/libcamlrun_pic.a $(RUNTIME_VARS) $(OLDS)
	# Build shared library with target-arch zstd
	# BYTECCLIBS includes -lzstd from configure, but searches wrong path ($PREFIX/lib has x86_64)
	# Prepend TARGET_ZSTD_LIBS to LDFLAGS so target-arch zstd is found first.
	# OCaml's MKDLL rule ignores LDFLAGS and configure bakes an unpathed -lzstd
	# into BYTECCLIBS, so BYTECCLIBS must carry the -L too. Prepend rather than
	# replace: BYTECCLIBS also carries libs the target glibc needs that the
	# build glibc does not.
	# When HAS_ZSTD=0, TARGET_ZSTD_LIBS is already empty (see its definition
	# above), so this link degrades to plain BYTECCLIBS/LDFLAGS with no -lzstd.
	$(MAKE) runtime/libcamlrun_shared.so $(RUNTIME_VARS) $(CROSS_SHARED_LIB_VARS) BYTECCLIBS='$(TARGET_ZSTD_LIBS) $(BYTECCLIBS)' LDFLAGS="$(TARGET_ZSTD_LIBS) $(LDFLAGS)" $(OLDS)
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
	# Compile NOZSTD_STUB_OBJ (see NOZSTD_STUB_OBJ and NATIVE_L1A_PIN) with the
	# BUILD C compiler against the BUILD ocaml and zstd headers; runtime/caml
	# is configured for the target and is not used here. The decompressor
	# matches runtime/zstd.c's caml_zstd_decompress.
	@mkdir -p "$(dir $(NOZSTD_STUB_OBJ))"
	@printf '%s\n' \
	  '#define CAML_INTERNALS' \
	  '#include <stdbool.h>' \
	  '#include <caml/intext.h>' \
	  '#include <caml/memory.h>' \
	  '#include <caml/mlvalues.h>' \
	  '#include <zstd.h>' \
	  '' \
	  'static size_t caml_zstd_decompress(unsigned char * blk,' \
	  '                                   uintnat uncompressed_data_len,' \
	  '                                   const unsigned char * intern_src,' \
	  '                                   uintnat data_len)' \
	  '{' \
	  '  return ZSTD_decompress(blk, uncompressed_data_len, intern_src, data_len);' \
	  '}' \
	  '' \
	  'CAMLprim value caml_zstd_initialize(value vunit)' \
	  '{' \
	  '  caml_intern_decompress_input = caml_zstd_decompress;' \
	  '  return Val_false;' \
	  '}' \
	  > "$(basename $(NOZSTD_STUB_OBJ)).c"
	_w="$(NATIVE_STDLIB)"; [ -n "$$_w" ] || _w=$$($(CAMLOPT) -where); \
	$(NATIVE_CC) -c -O2 -fPIC -I"$$_w" $(NOZSTD_STUB_ZSTD_CFLAGS) -o "$(NOZSTD_STUB_OBJ)" "$(basename $(NOZSTD_STUB_OBJ)).c"
	# Link the BUILD libasmrun* into NOZSTD_DIR: runtimeopt has already rebuilt
	# ./stdlib/libasmrun.a for the target, and the BUILD-arch link needs BUILD ones.
	_w="$(NATIVE_STDLIB)"; [ -n "$$_w" ] || _w=$$($(CAMLOPT) -where); \
	for _f in "$$_w"/libasmrun*; do [ -e "$$_f" ] && ln -sf "$$_f" "$(NOZSTD_DIR)/"; done; \
	[ -e "$(NOZSTD_DIR)/libasmrun.a" ] || { echo "no BUILD libasmrun.a in $$_w" >&2; exit 1; }
	# Build the work-tree stdlib.cmxa with the BUILD compiler so the BUILD-arch
	# native-compiler link just below links a BUILD-arch stdlib.cmxa that
	# matches the in-tree stdlib .cmi. The stdlib Makefile already compiles
	# with -nostdlib from its own directory, so no $(STDLIBFLAGS) is needed.
	CONDA_OCAML_AS="$(NATIVE_ASM)" CONDA_OCAML_CC="$(NATIVE_CC)" \
	  $(MAKE) -C stdlib allopt CAMLOPT="$(CAMLOPT)" OPTCOMPILER= COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS)
endif
	# Build native compilers (BUILD platform binaries) using CAMLOPT from PATH
	# NOTE: Do NOT clean compilerlibs here - they were built at line 194-195 with matching
	# stdlib CRCs. Cleaning them would force rebuild with PATH ocamlopt which uses
	# $PREFIX/lib/ocaml stdlib (different CRCs from work tree stdlib)
	# Set CONDA_OCAML_* env vars so ocamlopt finds NATIVE tools (not cross-tools)
	# NATIVE_ASM includes "-c" for macOS clang (space-separated, hence quoted)
	CONDA_OCAML_AS="$(NATIVE_ASM)" CONDA_OCAML_CC="$(NATIVE_CC)" \
	  $(MAKE) ocamlc.opt ocamlopt.opt $(TOOLS_NATIVE_TARGETS) $(NATIVE_L1A_TOOLS) \
	  $(NATIVE_COMPILER_OVERRIDES) OCAMLOPT=$(CAMLOPT) "$(HOST_ZSTD_LIBS)" $(OLDS) $(NATIVE_L1A_PIN)
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
	# Drop the BUILD-arch native stdlib so the allopt below rebuilds it for the
	# target. The stdlib .cmi stay: every stdlib .ml has a .mli, so the BUILD
	# compiler wrote no stdlib .cmi. Its compressed .cmt are rewritten when
	# the allopt below recompiles every module. stdlib/libcomprmarsh.a is a
	# link to the runtime library, not stdlib output, so it is kept.
	rm -f stdlib/*.cmx stdlib/*.o stdlib/stdlib.cmxa stdlib/stdlib.a
endif
	# CRITICAL FIX: Clean LIBDIR before building to prevent CRC mismatches
	# If LIBDIR has old .cmi files, unix.cmxa might find them via Config.standard_library
	# while stdlib.cmxa uses local .cmi files, causing "inconsistent assumptions"
	# By ensuring LIBDIR is empty, both use .cmi files from work tree
	@echo "=== Cleaning LIBDIR to ensure consistent .cmi usage ==="
	@rm -rf "$(LIBDIR)"
	@mkdir -p "$(LIBDIR)"
	# Build stdlib native directly using the FRESHLY BUILT cross-compiler (5.4.0 approach)
	# CRITICAL: Use absolute path to cross-compiler - ROOTDIR is relative (.) and breaks with -C
	# COMPILER_DEPS= disables bytecode compiler file dependency (for .cmi files)
	# OPTCOMPILER= disables native compiler file dependency (for .cmx files)
	$(MAKE) -C stdlib allopt CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" OPTCOMPILER= COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS)
	# CRITICAL FIX: Create complete stdlib environment at LIBDIR with fresh stdlib AND
	# native otherlibs dependencies (like Unix.cmi for systhreads).
	# Then set OCAMLLIB=LIBDIR so ocamlopt.opt finds fresh stdlib.cmxa for linking
	# while still being able to find Unix.cmi from native build.
	@echo "=== Setting up LIBDIR with fresh stdlib + native otherlibs deps ==="
	@mkdir -p "$(LIBDIR)"
	# Copy fresh stdlib (with NEW CRCs)
	@cp stdlib/*.cmi stdlib/*.cmo stdlib/*.cma stdlib/*.cmxa stdlib/*.a "$(LIBDIR)/" 2>/dev/null || true
	@cp stdlib/*.cmx "$(LIBDIR)/" 2>/dev/null || true
	# Copy .cmi and .cmx files from native otherlibs (for dependencies like Unix.cmi/cmx that systhreads needs)
	# DO NOT copy .cma/.cmxa - those have old CRCs and would cause "inconsistent assumptions" errors
	# The .cmi/.cmx files are for compilation/linking dependencies, not the final libraries
	@mkdir -p "$(LIBDIR)/unix" "$(LIBDIR)/str" "$(LIBDIR)/dynlink" "$(LIBDIR)/systhreads" "$(LIBDIR)/runtime_events"
	# Copy .cmi files (separate commands to handle missing files gracefully)
	@cp "$(NATIVE_STDLIB)/unix/"*.cmi "$(LIBDIR)/unix/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/str/"*.cmi "$(LIBDIR)/str/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/dynlink/"*.cmi "$(LIBDIR)/dynlink/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/systhreads/"*.cmi "$(LIBDIR)/systhreads/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/runtime_events/"*.cmi "$(LIBDIR)/runtime_events/" 2>/dev/null || true
	# Copy .cmx files (separate commands - may not exist if native build didn't install them)
	@cp "$(NATIVE_STDLIB)/unix/"*.cmx "$(LIBDIR)/unix/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/str/"*.cmx "$(LIBDIR)/str/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/dynlink/"*.cmx "$(LIBDIR)/dynlink/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/systhreads/"*.cmx "$(LIBDIR)/systhreads/" 2>/dev/null || true
	@cp "$(NATIVE_STDLIB)/runtime_events/"*.cmx "$(LIBDIR)/runtime_events/" 2>/dev/null || true
	# CRITICAL: Clean otherlibs .cmx/.cmi/.o to force rebuild with fresh stdlib CRCs
	# NOTE: Do NOT clean .cmxa/.a here - the working branch (mnt/v5.4.0_1-clean) doesn't
	# and cleaning them causes CRC mismatches. The Make system handles incremental rebuilds.
	@echo "=== Cleaning otherlibs .cmx to force rebuild ==="
	@rm -f otherlibs/unix/*.cmx otherlibs/unix/*.cmi otherlibs/unix/*.o
	@rm -f otherlibs/str/*.cmx otherlibs/str/*.cmi otherlibs/str/*.o
	@rm -f otherlibs/dynlink/*.cmx otherlibs/dynlink/*.cmi otherlibs/dynlink/*.o
	@rm -f otherlibs/dynlink/native/*.cmx otherlibs/dynlink/native/*.cmi otherlibs/dynlink/native/*.o
	@rm -f otherlibs/systhreads/*.cmx otherlibs/systhreads/*.cmi otherlibs/systhreads/*.o
	@rm -f otherlibs/runtime_events/*.cmx otherlibs/runtime_events/*.cmi otherlibs/runtime_events/*.o
	# Remove OLD .cmi from LIBDIR subdirs (copied from NATIVE_STDLIB above)
	# These have OLD CRCs and would cause threads.cmxa vs unix.cmxa mismatch
	@rm -f "$(LIBDIR)/unix/"*.cmi "$(LIBDIR)/str/"*.cmi "$(LIBDIR)/dynlink/"*.cmi
	@rm -f "$(LIBDIR)/systhreads/"*.cmi "$(LIBDIR)/runtime_events/"*.cmi
	# CRITICAL: Build native otherlibs in dependency order with OCAMLLIB pointing to LIBDIR
	# Build unix FIRST, copy fresh .cmi, then build systhreads which depends on Unix interface
	@echo "=== Building native otherlibs in dependency order ==="
	# Build unix first (no external otherlib dependencies)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/unix allopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Copy fresh Unix.cmi, Unix.cmx AND unix.cmxa to LIBDIR for systhreads dependency
	# CRITICAL: Unix.cmx contains implementation CRC - without it, VPATH finds NATIVE Unix.cmx
	# causing threads.cmxa to link against wrong Unix implementation CRC
	@echo "=== Copying fresh Unix.cmi + Unix.cmx + unix.cmxa to LIBDIR for systhreads ==="
	@cp otherlibs/unix/*.cmi "$(LIBDIR)/unix/"
	@cp otherlibs/unix/*.cmx "$(LIBDIR)/unix/" 2>/dev/null || true
	@cp otherlibs/unix/*.cmxa otherlibs/unix/*.a "$(LIBDIR)/unix/" 2>/dev/null || true
	# Build str (no Unix dependency)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/str allopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/str/*.cmi "$(LIBDIR)/str/"
	# Build dynlink
	OCAMLLIB="$(LIBDIR)" $(MAKE) dynlink-allopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(CROSS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/dynlink/*.cmi "$(LIBDIR)/dynlink/" 2>/dev/null || true
	# Build runtime_events (no external deps)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/runtime_events allopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/runtime_events/*.cmi "$(LIBDIR)/runtime_events/"
	# Build systhreads LAST (depends on Unix.cmi now in LIBDIR)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/systhreads allopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/systhreads/*.cmi "$(LIBDIR)/systhreads/"
	# CRITICAL: Rebuild bytecode otherlibs with OCAMLLIB override
	# Same CRC issue as native - ocamlc's Config.standard_library points to NATIVE_STDLIB
	# which has OLD CRCs from native build. Must override to use fresh stdlib from LIBDIR.
	@echo "=== Cleaning otherlibs bytecode to force rebuild with fresh CRCs ==="
	# Remove ALL bytecode artifacts (.cmo, .cmi, .cma) to force complete rebuild
	# OLD .cmi files from earlier build (lines 194-195) would cause CRC mismatch
	@rm -f otherlibs/unix/*.cmo otherlibs/unix/*.cmi otherlibs/unix/*.cma
	@rm -f otherlibs/str/*.cmo otherlibs/str/*.cmi otherlibs/str/*.cma
	@rm -f otherlibs/dynlink/*.cmo otherlibs/dynlink/*.cmi otherlibs/dynlink/*.cma
	@rm -f otherlibs/systhreads/*.cmo otherlibs/systhreads/*.cmi otherlibs/systhreads/*.cma
	@rm -f otherlibs/runtime_events/*.cmo otherlibs/runtime_events/*.cmi otherlibs/runtime_events/*.cma
	@rm -f otherlibs/dynlink/byte/*.cmo 2>/dev/null || true
	# Remove OLD .cmi from LIBDIR subdirs (copied from NATIVE_STDLIB at line 229)
	# These would pollute bytecode build with old CRCs via -I $(OCAMLLIB)/unix path
	@rm -f "$(LIBDIR)/unix/"*.cmi "$(LIBDIR)/str/"*.cmi "$(LIBDIR)/dynlink/"*.cmi
	@rm -f "$(LIBDIR)/systhreads/"*.cmi "$(LIBDIR)/runtime_events/"*.cmi
	@echo "=== Rebuilding bytecode otherlibs with OCAMLLIB override ==="
	# Build unix FIRST (no external otherlib dependencies)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/unix all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Copy fresh Unix.cmi to LIBDIR for systhreads dependency
	@echo "=== Copying fresh Unix.cmi to LIBDIR for systhreads ==="
	@cp otherlibs/unix/*.cmi "$(LIBDIR)/unix/"
	# Build str (no Unix dependency)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/str all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/str/*.cmi "$(LIBDIR)/str/"
	# Build dynlink
	OCAMLLIB="$(LIBDIR)" $(MAKE) dynlink-all $(CROSS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/dynlink/*.cmi "$(LIBDIR)/dynlink/" 2>/dev/null || true
	# Build runtime_events (no external deps)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/runtime_events all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/runtime_events/*.cmi "$(LIBDIR)/runtime_events/"
	# Build systhreads LAST (depends on Unix.cmi now in LIBDIR)
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs/systhreads all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	@cp otherlibs/systhreads/*.cmi "$(LIBDIR)/systhreads/"
	# Build ocamltoolsopt separately - these link against NATIVE stdlib (not cross)
	$(MAKE) ocamltoolsopt \
	  CAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  BEST_OCAMLOPT="$(RUN_TARGET) $(abspath $(ROOTDIR))/ocamlopt.opt" \
	  $(OLDS)
	# NOTE: Do NOT copy files to NATIVE_STDLIB!
	# NATIVE_STDLIB is the installed native compiler that gets packaged.
	# Overwriting its .cmi files with cross-built versions causes CRC mismatch:
	# - native unix.cma has OLD CRCs (from native build)
	# - if we copy NEW unix.cmi here, users get OLD cma + NEW cmi = error
	# The cross-compiler should use LIBDIR for its own files, not modify NATIVE_STDLIB.
	# ocamltoolsopt.opt builds NATIVE tools (ocamllex.opt etc.) - need NATIVE overrides
	# With STDLIB_CMI_PIN_INTREE=1 they are built at the native-compiler link
	# step instead (NATIVE_L1A_TOOLS), since the work-tree stdlib is now
	# target-arch.
ifneq "$(STDLIB_CMI_PIN_INTREE)" "1"
	CONDA_OCAML_AS="$(NATIVE_ASM)" CONDA_OCAML_CC="$(NATIVE_CC)" \
	  $(MAKE) ocamltoolsopt.opt $(NATIVE_COMPILER_OVERRIDES) $(OLDS) $(NATIVE_L1A_PIN)
endif
	# Copy stublibs to where the cross-compiler expects them
	# The compiler has Config.standard_library baked in (pointing to PREFIX/lib/ocaml)
	# and looks for stublibs relative to that path. We must copy before CROSSCOMPILERLIBS.
	@echo "=== Copying stublibs to $(LIBDIR)/stublibs ==="
	mkdir -p "$(LIBDIR)/stublibs"
	@for f in otherlibs/*/dll*.so; do \
	  if [ -f "$$f" ]; then \
	    echo "  Copying: $$f"; \
	    cp "$$f" "$(LIBDIR)/stublibs/"; \
	  fi; \
	done
	# We now build the compiler libs again, but for target this time
ifeq "$(STDLIB_CMI_PIN_INTREE)" "1"
	# The native-compiler build above (NATIVE_COMPILER_OVERRIDES at the
	# ocamlc.opt/ocamlopt.opt link step, and ocamltoolsopt.opt just above)
	# resolves any of its own CAMLC/CAMLOPT bare invocations against the
	# installed PATH toolchain wherever a pin does not cover them, poisoning
	# any compilerlibs .cmi it touches with the installed stdlib's CRCs
	# rather than the in-tree one. Purge those .cmi so the rebuild just
	# below regenerates them cleanly.
	rm -f $(CROSSCOMPILERLIBS_CMI)
endif
	# CRITICAL: Also remove .cmi files from compilerlibs to prevent CRC mismatches
	# The .cmi files from earlier stages have OLD stdlib CRCs
	rm -f $(ocamlcommon_NCOBJS) $(ocamlmiddleend_NCOBJS) \
	  $(ocamlbytecomp_NCOBJS) $(ocamloptcomp_NCOBJS) \
	  $(ocamltoplevel_NCOBJS) $(CROSSCOMPILERLIBS)
	rm -f utils/*.cmi parsing/*.cmi lambda/*.cmi bytecomp/*.cmi \
	  file_formats/*.cmi typing/*.cmi driver/*.cmi toplevel/*.cmi asmcomp/*.cmi
	rm -f middle_end/*.cmi middle_end/**/*.cmi 2>/dev/null || true
	$(MAKE) $(CROSSCOMPILERLIBS) $(CROSS_COMPILERLIBS_OVERRIDES) $(OLDS)

.PHONY: crosscompiledopt
crosscompiledopt:
	# When STDLIB_CMI_PIN_INTREE=1, build only ocamlc now and defer the other
	# bytecode tools until after the stdlib rebuild below, so their .cmi are
	# written by the in-tree zstd-free ocamlc instead of the zstd-enabled PATH
	# ocamlc used on every other platform. Unlike crossopt, this target runs
	# after the in-tree stdlib already exists, so no separate stdlib rebuild
	# step is needed here.
ifeq ($(STDLIB_CMI_PIN_INTREE),1)
	$(MAKE) ocamlc $(CROSS_COMPILER_OVERRIDES) CAMLC="ocamlc $(STDLIBFLAGS)" $(OLDS)
else
	$(MAKE) ocamlc $(TOOLS_BYTECODE_TARGETS) expunge$(EXE) \
	  $(CROSS_COMPILER_OVERRIDES) $(OLDS)
endif
	# Build stdlib directly (same reason as crossopt)
	$(MAKE) -C stdlib all CAMLC=ocamlc COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS) $(NATIVE_CAMLC_PIN)
ifeq ($(STDLIB_CMI_PIN_INTREE),1)
	# $(STDLIBFLAGS) is appended (on top of the in-tree runtime/ocamlc prefix)
	# because the generic %.cmi: %.mli rule invokes $(CAMLC) verbatim with no
	# stdlib flags from CROSS_COMPILER_OVERRIDES.
	$(MAKE) $(TOOLS_BYTECODE_TARGETS) expunge$(EXE) \
	  $(CROSS_COMPILER_OVERRIDES) CAMLC="$(RUN_TARGET) $(abspath $(ROOTDIR))/runtime/ocamlrun $(abspath $(ROOTDIR))/ocamlc$(EXE) $(STDLIBFLAGS)" $(OLDS)
endif
	$(MAKE) ocamlyacc $(CROSS_OVERRIDES) $(OLDS)
	$(MAKE) ocamllex $(CROSS_COMPILER_OVERRIDES) $(OLDS)
	$(MAKE) ocaml $(CROSS_COMPILER_OVERRIDES) $(OLDS)
ifeq ($(STDLIB_CMI_PIN_INTREE),1)
	# The ocaml step above recompiles driver/main with the zstd-enabled PATH
	# ocamlc, leaving a compressed driver/main.cmi the zstd-free cross ocamlopt
	# cannot read. Rebuild just that unit with the in-tree ocamlc; pinning the
	# whole step instead makes the in-tree ocamlc relink objects it cannot read.
	rm -f driver/main.cmi driver/main.cmo
	$(MAKE) driver/main.cmo $(CROSS_COMPILER_OVERRIDES) $(OLDS) $(CROSS_CAMLC_PIN)
endif
	$(MAKE) dynlink-all $(CROSS_OVERRIDES) $(OLDS)
	$(MAKE) -C otherlibs all $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS)
	$(MAKE) runtimeopt $(RUNTIME_VARS) $(OLDS)
	# Clean dynlink to prevent .cmi inconsistencies
	rm -f otherlibs/dynlink/*.cmx otherlibs/dynlink/*.cmi otherlibs/dynlink/*.o
	rm -f otherlibs/dynlink/native/*.cmx otherlibs/dynlink/native/*.cmi otherlibs/dynlink/native/*.o
	# Build native compilers (BUILD platform) with NATIVE tools via env vars
	CONDA_OCAML_AS="$(NATIVE_ASM)" CONDA_OCAML_CC="$(NATIVE_CC)" \
	  $(MAKE) ocamlc.opt ocamlopt.opt $(TOOLS_NATIVE_TARGETS) \
	  $(NATIVE_COMPILER_OVERRIDES) OCAMLOPT=$(CAMLOPT) "$(HOST_ZSTD_LIBS)" $(OLDS)
	# Build stdlib native with cross-compiler from _cross/bin (TARGET platform)
	$(MAKE) -C stdlib allopt CAMLOPT=$(CAMLOPT) OPTCOMPILER= COMPILER_DEPS= $(CROSS_OVERRIDES) $(OLDS)
	# Clean dynlink again before otherlibrariesopt
	@echo "=== Cleaning dynlink files before otherlibrariesopt ==="
	rm -fv otherlibs/dynlink/*.cmx otherlibs/dynlink/*.cmi otherlibs/dynlink/*.o 2>/dev/null || true
	rm -fv otherlibs/dynlink/native/*.cmx otherlibs/dynlink/native/*.cmi otherlibs/dynlink/native/*.o 2>/dev/null || true
	# Build otherlibs and tools with cross-compiler
	# CAMLOPT is pinned above; CAMLC would otherwise fall through to bare
	# ocamlc, so pin it too on both lines below.
	$(MAKE) otherlibrariesopt CAMLOPT=$(CAMLOPT) OCAMLOPT=$(CAMLOPT) BEST_OCAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	$(MAKE) ocamltoolsopt CAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(OLDS) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Build native tools (ocamllex.opt) with NATIVE tools
	CONDA_OCAML_AS="$(NATIVE_ASM)" CONDA_OCAML_CC="$(NATIVE_CC)" \
	  $(MAKE) ocamltoolsopt.opt $(NATIVE_COMPILER_OVERRIDES) $(OLDS)
	# Copy stublibs to where the cross-compiler expects them (same as crossopt)
	@echo "=== Copying stublibs to $(LIBDIR)/stublibs ==="
	mkdir -p "$(LIBDIR)/stublibs"
	@for f in otherlibs/*/dll*.so; do \
	  if [ -f "$$f" ]; then \
	    echo "  Copying: $$f"; \
	    cp "$$f" "$(LIBDIR)/stublibs/"; \
	  fi; \
	done
	# We now build the compiler libs again, but for target this time
	rm -f $(ocamlcommon_NCOBJS) $(ocamlmiddleend_NCOBJS) \
	  $(ocamlbytecomp_NCOBJS) $(ocamloptcomp_NCOBJS) \
	  $(ocamltoplevel_NCOBJS) $(CROSSCOMPILERLIBS)
	$(MAKE) $(CROSSCOMPILERLIBS) $(CROSSCOMPILED_COMPILERLIBS_OVERRIDES) $(OLDS)

# ============================================================================
# crosscompiledruntime: Build runtime for TARGET platform
# conda-forge addition - builds native runtime after crosscompiledopt
# ============================================================================
# BYTECCLIBS/NATIVECCLIBS must be passed to recursive make for cross-compilation
# because configure detected libraries for BUILD platform, not TARGET.
# e.g., TARGET glibc 2.17 needs -ldl but BUILD glibc 2.34 doesn't.
.PHONY: crosscompiledruntime
crosscompiledruntime:
	$(MAKE) runtime-all $(RUNTIME_VARS) BYTECCLIBS='$(BYTECCLIBS)' NATIVECCLIBS='$(NATIVECCLIBS)' $(OLDS)

# ============================================================================
# Override otherlibraries targets to use CROSS_OTHERLIBS_OVERRIDES
# The main Makefile's otherlibraries/otherlibrariesopt don't pass CC/AR/MKLIB,
# causing wrong linker to be used for C stub libraries (otherlibs).
# ============================================================================
# CRITICAL: otherlibraries must use OCAMLLIB override to prevent bytecode CRC mismatches.
# Without this, bytecode libs rebuilt via this target (e.g., from install dependencies)
# would use OLD stdlib CRCs from native build instead of fresh ones.
# CRITICAL: Override otherlibraries to use OCAMLLIB and avoid unwanted rebuilds
# The upstream target has dependencies (ocamltools, dynlink-all) that can trigger
# bytecode rebuilds WITHOUT OCAMLLIB override, causing CRC mismatches.
# By removing prerequisites, we ensure this target ONLY builds otherlibs when explicitly called.
.PHONY: otherlibraries
otherlibraries:
	# CAMLC must be pinned alongside CAMLOPT: pinning CAMLOPT alone does not
	# stop the .cmi files from being rewritten by the wrong CAMLC.
	OCAMLLIB="$(LIBDIR)" $(MAKE) -C otherlibs all $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)

.PHONY: otherlibrariesopt
otherlibrariesopt: dynlink-allopt
	# CAMLC must be pinned alongside CAMLOPT: pinning CAMLOPT alone does not
	# stop the .cmi files from being rewritten by the wrong CAMLC.
	$(MAKE) -C otherlibs allopt $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)

# Cross-compilation variant: calls dynlink-allopt with proper compiler variables
# Use this instead of otherlibrariesopt when cross-compiling to avoid
# "inconsistent assumptions" errors (dynlink compiled with wrong compiler)
# Must pass ALL compiler variables: OCAMLOPT, CAMLOPT, BEST_OCAMLOPT
.PHONY: otherlibrariesopt-cross
otherlibrariesopt-cross:
	# Clean otherlibs to force rebuild with fresh CRCs
	rm -f otherlibs/unix/*.cmx otherlibs/unix/*.cmi otherlibs/unix/*.o
	rm -f otherlibs/str/*.cmx otherlibs/str/*.cmi otherlibs/str/*.o
	rm -f otherlibs/dynlink/*.cmx otherlibs/dynlink/*.cmi otherlibs/dynlink/*.o
	rm -f otherlibs/dynlink/native/*.cmx otherlibs/dynlink/native/*.cmi otherlibs/dynlink/native/*.o
	rm -f otherlibs/systhreads/*.cmx otherlibs/systhreads/*.cmi otherlibs/systhreads/*.o
	rm -f otherlibs/runtime_events/*.cmx otherlibs/runtime_events/*.cmi otherlibs/runtime_events/*.o
	rm -f $(OCAMLLIB)/dynlink*.cmi $(OCAMLLIB)/dynlink*.cmx $(OCAMLLIB)/dynlink*.cmo $(OCAMLLIB)/dynlink*.cma $(OCAMLLIB)/dynlink*.cmxa 2>/dev/null || true
	# Remove OLD .cmi from OCAMLLIB subdirs to prevent CRC mismatch
	rm -f "$(OCAMLLIB)/unix/"*.cmi "$(OCAMLLIB)/str/"*.cmi "$(OCAMLLIB)/dynlink/"*.cmi 2>/dev/null || true
	rm -f "$(OCAMLLIB)/threads/"*.cmi "$(OCAMLLIB)/runtime_events/"*.cmi 2>/dev/null || true
	# Build in dependency order: unix FIRST, then systhreads LAST (depends on Unix interface)
	@echo "=== Building native otherlibs in dependency order ==="
	# Build unix first (no external otherlib dependencies)
	# These allopt calls pin CAMLOPT but must also pin CAMLC: CAMLC is what
	# writes the .cmi, and without the pin it falls through to the bare
	# CAMLC=ocamlc inside CROSS_OTHERLIBS_OVERRIDES/CROSS_OVERRIDES, i.e.
	# the PATH zstd-enabled bootstrap. Self-scoping: NATIVE_OTHERLIBS_CAMLC_PIN
	# is empty unless STDLIB_CMI_PIN_INTREE=1.
	OCAMLLIB="$(OCAMLLIB)" $(MAKE) -C otherlibs/unix allopt CAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Copy fresh Unix.cmi to OCAMLLIB for systhreads dependency
	@mkdir -p "$(OCAMLLIB)/unix"
	@cp otherlibs/unix/*.cmi "$(OCAMLLIB)/unix/"
	# Build str (no Unix dependency)
	OCAMLLIB="$(OCAMLLIB)" $(MAKE) -C otherlibs/str allopt CAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Build dynlink
	OCAMLLIB="$(OCAMLLIB)" $(MAKE) dynlink-allopt OCAMLOPT=$(CAMLOPT) CAMLOPT=$(CAMLOPT) BEST_OCAMLOPT=$(CAMLOPT) $(CROSS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Build runtime_events (no external deps)
	OCAMLLIB="$(OCAMLLIB)" $(MAKE) -C otherlibs/runtime_events allopt CAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)
	# Build systhreads LAST (depends on Unix.cmi now in OCAMLLIB)
	OCAMLLIB="$(OCAMLLIB)" $(MAKE) -C otherlibs/systhreads allopt CAMLOPT=$(CAMLOPT) $(CROSS_OTHERLIBS_OVERRIDES) $(NATIVE_OTHERLIBS_CAMLC_PIN)

.PHONY: cross-flexdll
cross-flexdll: | $(BYTE_BINDIR) $(OPT_BINDIR)
	rm -f $(FLEXDLL_SOURCE_DIR)/flexlink.exe
	$(MAKE) -C $(FLEXDLL_SOURCE_DIR) $(FLEXLINK_BUILD_ENV) \
	  NATDYNLINK=false LINKFLAGS= flexlink.exe support
	$(LN) $(FLEXDLL_SOURCE_DIR)/flexlink.exe flexlink.opt.exe
	$(LN) flexlink.opt.exe flexlink.byte.exe
	cp flexlink.byte.exe $(BYTE_BINDIR)/flexlink
	cd $(BYTE_BINDIR) && $(LN) flexlink flexlink.exe
	cp $(addprefix $(FLEXDLL_SOURCE_DIR)/, $(FLEXDLL_OBJECTS)) $(ROOTDIR)
	cp flexlink.opt.exe $(OPT_BINDIR)/flexlink
	cd $(OPT_BINDIR) && $(LN) flexlink flexlink.exe

# CRITICAL: INSTALLING=1 makes VPATH conditional skip in Makefile.cross line 43
# Without this, recursive makes re-include Makefile.cross and set VPATH := + $(VPATH)
# causing Make to find OLD unix.cmxa from native stdlib before fresh build in otherlibs/
INSTALL_OVERRIDES=build_ocamldoc=false WITH_DEBUGGER= OCAMLRUN=ocamlrun INSTALLING=1 VPATH= $(if $(CROSS_MKDLL),SUPPORTS_SHARED_LIBRARIES=true)

.PHONY: installcross
installcross:
	# Create dummy files to keep `install` happy
	touch \
	  $(addprefix toplevel/, \
	    $(foreach ext,cmi cmt cmti cmx, native/nat__dummy__.$(ext)) \
	      all__dummy__.cmx topstart.o native/tophooks.cmi)
	# Only create symlinks if binaries don't exist (Stage 3 builds real binaries)
	test -f lex/ocamllex.opt$(EXE) || $(LN) `command -v ocamllex` lex/ocamllex.opt$(EXE)
	test -f yacc/ocamlyacc.opt$(EXE) || $(LN) `command -v ocamlyacc` yacc/ocamlyacc.opt$(EXE)
	# NOTE: Do NOT delete files from NATIVE_STDLIB here!
	# NATIVE_STDLIB is the installed native compiler that gets packaged.
	# Deleting unix.cma/.cmi from there breaks the native package.
	# VPATH pollution is prevented by INSTALLING=1 VPATH= in INSTALL_OVERRIDES.
	$(TOPLEVEL_BYTE_CMI_RESTORE)
	# Real installation (VPATH= is in INSTALL_OVERRIDES to propagate to recursive sub-makes)
	$(MAKE) install $(INSTALL_OVERRIDES)
